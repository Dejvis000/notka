root = true

[*]
charset = utf-8
end_of_line = crlf
insert_final_newline = true
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

[*.{csproj,props,targets,xaml,json,yml,yaml}]
indent_size = 2

[*.cs]
csharp_style_namespace_declarations = block_scoped:warning
dotnet_sort_system_directives_first = true
